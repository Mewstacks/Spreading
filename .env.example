# Gere a chave com: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WAHA_SESSION=default
# Dashboard do WAHA (passkey): python tools/waha_access.py copia a senha e a chave sem imprimir
# WAHA_DASHBOARD_USERNAME=admin
# WAHA_DASHBOARD_URL=http://localhost:3000/dashboard/
FEED_MAX_AGE_SECONDS=3600
# Link Builder do ML (opcional, perfil `linkbuilder` do compose). Sessão: tools/ml_login.py
# LINKBUILDER_ENABLED=1
# LINKBUILDER_MAX_PER_RUN=8
# LINKBUILDER_MAX_PER_DAY=120
# LINKBUILDER_VERIFY=1
# Shopee Affiliate Open API (opcional)
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
# SHOPEE_TRACK=0  (desliga o link curto com sub-id por grupo)
# Canário (opcional): chat privado para a mensagem de teste; sem ele o comando só sonda o WhatsApp
# CANARY_CHAT_ID=1203@g.us
# CANARY_CHATS=numero2=1204@g.us
# Produção atrás de TLS (Caddy, Fly): cookies seguros, redirect para https e HSTS
# DJANGO_HTTPS=1
# Alertas (opcional): aviso por WhatsApp (chat do dono) e/ou e-mail quando algo para
# ALERT_CHAT_ID=5511999999999@c.us
# ALERT_EMAIL_TO=dono@exemplo.com
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
